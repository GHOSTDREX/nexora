# Python
**/__pycache__/
**/*.py[cod]
**/venv/
**/.venv/
**/.env

# Node
**/node_modules/
**/dist/
**/dist-ssr/

# Runtime data (regenerated automatically, never source)
backend/data/*.db
backend/logs/*.log

# Trained model artifacts too large for GitHub (100MB hard limit) —
# regenerate with `python "Yield Prediction/src/train_model.py"`
backend/app/ml/yield_prediction/models/final_yield_prediction_model.pkl
Yield Prediction/model/final_yield_prediction_model.pkl

# Claude Code local tooling (skills, agent config) — not app source
.claude/
.agents/

# OS / editor junk
.DS_Store
Thumbs.db
*.swp


# SQLite journal files
backend/data/*.db-journal

# One-off camera-snapshot exports pulled from the local DB for manual review
backend/snapshots_export/

# Reference source repo for the paddy disease model (3.9GB, not app source —
# see backend/app/ml/disease_detection/ for the ported production pipeline)
Smart-Farming-AI/

# Local ngrok tunnel logs
ngrok.log

# Real device WiFi credentials (never commit — see secrets.h.example in
# each firmware sketch folder for the placeholder template)
sensors/secrets.h
motor_controls/secrets.h
AI_THINKER_CAM/secrets.h
