# Copy this file to .env and fill in real values.

# Optional — enables the real LLM-powered AI Assistant (Claude API). If left
# blank, the assistant automatically falls back to a rule-based responder
# (English / Hindi / Marathi only) so the app still works without a key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Change this in any real deployment.
JWT_SECRET=agrinova-dev-secret-change-me
JWT_EXPIRE_MINUTES=1440

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# How often (seconds) the simulated sensor feed advances.
SIMULATOR_TICK_SECONDS=4

# Optional — enables live mandi (market) prices on the Dashboard via the
# government's Agmarknet dataset on data.gov.in. Free signup, instant key:
# https://data.gov.in/user/register — if left blank, the Market card shows
# a "connect your free key" message instead of prices.
AGMARKNET_API_KEY=

# Optional — enables the WhatsApp bot (Meta WhatsApp Cloud API, free tier).
# Requires a Meta developer app with the WhatsApp product added:
# https://developers.facebook.com -> My Apps -> Create App -> WhatsApp.
# WHATSAPP_VERIFY_TOKEN is any string you make up yourself (Meta echoes it
# back during webhook setup to prove you own the endpoint).
# Webhook URL to register with Meta: https://<public-host>/api/whatsapp/webhook
# (local dev needs a tunnel, e.g. ngrok, since Meta can't reach localhost).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
